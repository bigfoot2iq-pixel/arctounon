# Copy to .env.local and fill in. All values here are server-side only.

# Supabase project (Dashboard → Project Settings → API).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Wallet export is public (no auth): GET /api/allowlist/download?format=txt|json

# Optional: WalletConnect Cloud project id for mobile/QR wallets.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<project-id>
