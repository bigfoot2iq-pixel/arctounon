# Deployer wallet private key (include the 0x prefix). NEVER commit the real .env.
DEPLOYER_PRIVATE_KEY=0xyour_private_key_here

# Arc testnet RPC (the default already works).
ARC_RPC_URL=https://rpc.testnet.arc.network

# Optional: metadata base URI passed to the constructor at deploy time.
# Token metadata is served at <BASE_URI><tokenId>.json — keep the trailing slash.
BASE_URI=
